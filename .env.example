# Copy to .env and fill in values

# Environment: "dev" or "prod"
#   dev  → live detection viewer at http://<host>:<port>/dev (MJPEG, per-camera)
#   prod → viewer code is never imported or exposed
APP_ENV=dev

# YOLO model
# Pretrained YOLOv8 for testing — ultralytics downloads it automatically on first use
# Replace with your trained model path when ready: models/best.pt
MODEL_PATH=src/models/runs/detect/runs/passenger_yolov8-2/weights/best.onnx
YOLO_INPUT_SIZE=640
CONFIDENCE_THRESHOLD=0.35
# NMS IoU threshold. Ultralytics' 0.7 default is loose and can count one head as
# 2-3 overlapping boxes; 0.45 merges those duplicates. Lower it if over-counting.
NMS_IOU_THRESHOLD=0.45

# Backend — JSON POST to <URL>/api/v1/device/input, authorized with a bearer
# token obtained from the login endpoint below (see Device auth).
CLOUDFLARE_API_URL=https://busproject.marceverse.com
# Static-key fallback — only used if no login token is available. Leave empty
# when using device login (DEVICE_USERNAME/DEVICE_PASSWORD) below.
CLOUDFLARE_API_KEY=
CLOUDFLARE_TIMEOUT=10

# Device auth — at startup the service logs in here to get a bearer token, then
# attaches it to every device/input upload. On a 401 (token expired) it re-logs
# in and retries automatically.
AUTH_LOGIN_PATH=/api/v1/auth/login
DEVICE_USERNAME=device
DEVICE_PASSWORD=w7ePNd6j8FMSwaKH3v0McATx
# Seconds between login attempts while the backend is unreachable at startup.
AUTH_LOGIN_RETRY_INTERVAL=10

# Database (single SQLite file — both cameras and queue tables)
DATABASE_URL=sqlite:///data/app.db

# Aggregator — how often to flush averaged crowd counts to Cloudflare (seconds)
AGGREGATOR_FLUSH_INTERVAL=30

# Failsafe queue retry
RETRY_INTERVAL_SECONDS=30
MAX_RETRY_ATTEMPTS=10

# Bus identification — set to the numeric busId of this Pi's bus
BUS_ID=1
BUS_INFO_REFRESH_SECONDS=300

# Camera-ID template — {bus} = numeric busId, {pos} = position suffix (001/002/003)
# Result example: CAM-BUS34-001  (if you want the route number instead, set BUS_ID to the route prefix)
CAMERA_ID_TEMPLATE=CAM-BUS{bus}-{pos}

# UDP broadcast camera-sync — Pi sends capture triggers so all cameras fire simultaneously
CAMERA_SYNC_ENABLED=true
CAMERA_SYNC_BROADCAST_ADDR=255.255.255.255
CAMERA_SYNC_PORT=5005
# Capture cadence (seconds between broadcast triggers). This is the hard ceiling
# on the live-feed frame rate — 1s ≈ 1 fps in /dev and the ROI editor, 2s ≈ 0.5.
# Floor is 1s: the sync-round grouping key is an integer-second timestamp, so two
# triggers in the same second collide and the second frame is dropped. Lower this
# only if the Pi keeps up with inference for every camera at the new rate.
# GROUP_BUCKET_SIZE must match this value.
CAMERA_SYNC_INTERVAL_SECONDS=1

# Frame grouper. GROUP_BUCKET_SIZE = NTP capture-bucket width in seconds (match
# CAMERA_SYNC_INTERVAL_SECONDS). GROUP_WINDOW_MS = how long to wait after the
# first frame of a round before processing (the fallback when a camera is late;
# with EXPECTED_CAMERAS set, a full round early-fires before this elapses).
GROUP_BUCKET_SIZE=1
GROUP_WINDOW_MS=500

# Number of cameras on this bus. When >0 a sync round is processed as soon as
# this many frames arrive (instead of always waiting GROUP_WINDOW_MS). Set to 3.
EXPECTED_CAMERAS=3

# Per-pane ROIs — JSON map of pane -> normalized [x1,y1,x2,y2] (0..1) box.
# The pane key is the device_id lowercased with "cam-" stripped, so a camera
# flashed with DEVICE_ID="CAM-front" uses key "front" (NOT 001/002/003).
# The 3 ROIs must TILE the bus with no overlap (else people are double-counted)
# and no gaps (else missed). Cameras with no ROI here count the WHOLE frame.
#
# A pane may instead be a freeform polygon — a list of [x,y] vertices (>=3), e.g.
# {"front":[[0,0],[1,0],[1,0.34],[0,0.34]]}. Boxes and polygons can be mixed.
#
# EASIEST: open the ROI editor at http://<host>:<port>/roi (works in dev AND prod)
# to draw the region over the live camera image — YOLO detections are overlaid
# (green = counted / gray = outside) with a live in-region head count — then Save.
# Saved shapes go to data/camera_rois.json, which OVERRIDES this CAMERA_ROIS at
# startup — so this var is just the initial seed once the file exists.
# Example:
# CAMERA_ROIS={"front":[0.0,0.0,1.0,0.34],"mid":[0.0,0.34,1.0,0.67],"rear":[0.0,0.67,1.0,1.0]}
CAMERA_ROIS=

# How often (seconds) to re-sync ROIs from data/camera_rois.json so edits made
# outside the API (hand-edited file / another worker) apply without a restart.
# Editor saves are already live immediately. 0 disables the periodic reload.
ROI_RELOAD_INTERVAL_SECONDS=30

# Server
HOST=0.0.0.0
PORT=8000

# Logging
# Levels: DEBUG | INFO | WARNING | ERROR
# Set DEBUG temporarily when troubleshooting on the Pi, then switch back to INFO.
LOG_LEVEL=INFO
# Directory for rotating log files (relative to where you run uvicorn from).
# ~15 MB max on disk (5 MB × 3 backups). Safe for the Pi 4 SD card.
LOG_DIR=logs
