# Copy to .env and fill in values

# Environment: "dev" or "prod"
#   dev  → live detection viewer at http://<host>:<port>/dev (MJPEG, per-camera)
#   prod → viewer code is never imported or exposed
APP_ENV=dev

# YOLO model
# Pretrained YOLOv8 for testing — ultralytics downloads it automatically on first use
# Replace with your trained model path when ready: models/best.pt
MODEL_PATH=src/models/runs/detect/runs/passenger_yolov8-5/weights/best_ncnn_model
YOLO_INPUT_SIZE=640
CONFIDENCE_THRESHOLD=0.5

# Cloudflare backend
CLOUDFLARE_API_URL=https://bus-occupancy-api.marceverse-bus.workers.dev
CLOUDFLARE_API_KEY=your_api_key_here
CLOUDFLARE_TIMEOUT=10

# Database (single SQLite file — both cameras and queue tables)
DATABASE_URL=sqlite:///data/app.db

# Aggregator — how often to flush averaged crowd counts to Cloudflare (seconds)
AGGREGATOR_FLUSH_INTERVAL=60

# Failsafe queue retry
RETRY_INTERVAL_SECONDS=30
MAX_RETRY_ATTEMPTS=10

# Bus identification — set to the numeric busId of this Pi's bus
BUS_ID=1
BUS_INFO_REFRESH_SECONDS=300

# Camera-ID template — {bus} = numeric busId, {pos} = position suffix (001/002/003)
# Result example: CAM-BUS34-001  (if you want the route number instead, set BUS_ID to the route prefix)
CAMERA_ID_TEMPLATE=CAM-BUS{bus}-{pos}

# UDP broadcast camera-sync — Pi sends capture triggers so all cameras fire simultaneously
CAMERA_SYNC_ENABLED=true
CAMERA_SYNC_BROADCAST_ADDR=255.255.255.255
CAMERA_SYNC_PORT=5005
# Match capture cadence with GROUP_BUCKET_SIZE (seconds)
CAMERA_SYNC_INTERVAL_SECONDS=2

# Server
HOST=0.0.0.0
PORT=8000

# Logging
# Levels: DEBUG | INFO | WARNING | ERROR
# Set DEBUG temporarily when troubleshooting on the Pi, then switch back to INFO.
LOG_LEVEL=INFO
# Directory for rotating log files (relative to where you run uvicorn from).
# ~15 MB max on disk (5 MB × 3 backups). Safe for the Pi 4 SD card.
LOG_DIR=logs
